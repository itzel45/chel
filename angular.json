{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "ventanilla": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": { "builder": "@angular/build:application", "options": { "outputPath": "dist/ventanilla", "index": "src/index.html", "browser": "src/main.ts", "polyfills": ["zone.js"], "tsConfig": "tsconfig.app.json", "styles": ["src/styles.css"] }, "configurations": { "production": { "optimization": true, "outputHashing": "all" } } },
        "serve": { "builder": "@angular/build:dev-server", "configurations": { "production": { "buildTarget": "ventanilla:build:production" }, "development": { "buildTarget": "ventanilla:build" }, "defaultConfiguration": "development" } }
      }
    }
  }
}
